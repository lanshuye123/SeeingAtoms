# ---------------------------------------------------------------------------
# Version-control policy
# Track: source, docs, scripts, Manim/TTS code, CIF source data, fonts/licenses.
# Do not track: anything regenerated by scripts/Makefile (audio, video, frames,
# subtitles, calculated patterns, caches, logs).
# ---------------------------------------------------------------------------

# Python / editor / OS
.venv/
.cache/
__pycache__/
*.py[cod]
.DS_Store

# Generated media and build outputs
media/
logs/
*.mp4
*.wav
*.srt
*.ass

# S01 generated audio (TTS, music, mixes, manifests)
chapters/s01/audio/

# S01 generated subtitles, videos, intermediate renders, QC frames
chapters/s01/renders/*
!chapters/s01/renders/qc_report.md

# S01 generated visual assets and calculated patterns
chapters/s01/assets/style_frame_*.png
chapters/s01/assets/xrd_patterns.json
chapters/s01/assets/xrd_patterns.txt

# S01 generated text derived from script.md
chapters/s01/script/narration.txt
chapters/s01/script/segments.json
chapters/s01/script/scene_segments.json

# Third-party font binaries are re-fetchable; keep their licenses in Git.
assets/fonts/*.otf
assets/fonts/*.ttf

# Keep small source data and licenses
!chapters/s01/assets/cif/
!chapters/s01/assets/cif/*.cif
